#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PRODUCT_DIR="$ROOT_DIR/product"
BARE_DIR="$PRODUCT_DIR/.bare"

usage() {
  cat <<'USAGE'
Usage:
  habenae product init <repository-url> [default-branch]
  habenae product add <branch> [start-point] [relative-path]
  habenae product list
  habenae product remove <relative-path>
  habenae product prune
  habenae doctor [--knowledge]
USAGE
}

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_git() {
  command -v git >/dev/null 2>&1 || fail "git is required."
}

require_product_repository() {
  [[ -d "$BARE_DIR" && -f "$PRODUCT_DIR/.git" ]] ||
    fail "the product repository is not initialized; run 'habenae product init <url>'."
}

validate_relative_path() {
  local value="$1"
  [[ -n "$value" ]] || fail "the path cannot be empty."
  [[ "$value" != /* ]] || fail "the path must be relative to product/."
  [[ "/$value/" != *"/../"* && "/$value/" != *"/./"* ]] ||
    fail "'.' and '..' path segments are not allowed."
  [[ "$value" != ".git" && "$value" != ".bare" && "$value" != .git/* && "$value" != .bare/* ]] ||
    fail "this path is reserved for Git."
}

git_product() {
  git --git-dir="$BARE_DIR" "$@"
}

product_init() {
  local repository_url="${1:-}"
  local requested_branch="${2:-}"
  local branch remote_ref

  [[ -n "$repository_url" ]] || fail "the code repository URL is required."
  [[ ! -e "$PRODUCT_DIR/.git" && ! -e "$BARE_DIR" ]] ||
    fail "product/ already contains a Git repository."

  if [[ -d "$PRODUCT_DIR" ]] && find "$PRODUCT_DIR" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    fail "product/ must be empty before initialization."
  fi

  mkdir -p "$PRODUCT_DIR"
  git clone --bare "$repository_url" "$BARE_DIR"
  printf 'gitdir: ./.bare\n' > "$PRODUCT_DIR/.git"
  git_product config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  git_product fetch --prune origin
  git_product remote set-head origin -a >/dev/null 2>&1 || true

  if [[ -n "$requested_branch" ]]; then
    branch="$requested_branch"
  else
    remote_ref="$(git_product symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    if [[ -n "$remote_ref" ]]; then
      branch="${remote_ref#origin/}"
    else
      branch="$(git_product symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    fi
  fi

  [[ -n "$branch" ]] || fail "the default branch could not be detected; rerun with its name as the second argument."
  validate_relative_path "$branch"

  if git_product show-ref --verify --quiet "refs/heads/$branch"; then
    git_product worktree add "$PRODUCT_DIR/$branch" "$branch"
    if git_product show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git_product branch --set-upstream-to="origin/$branch" "$branch" >/dev/null 2>&1 || true
    fi
  elif git_product show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git_product worktree add --track -b "$branch" "$PRODUCT_DIR/$branch" "origin/$branch"
  else
    fail "branch '$branch' does not exist locally or on origin."
  fi

  printf 'Product repository initialized. Worktree: product/%s\n' "$branch"
}

product_add() {
  local branch="${1:-}"
  local start_point="${2:-origin/HEAD}"
  local relative_path="${3:-${1:-}}"
  local target

  [[ -n "$branch" ]] || fail "the branch name is required."
  validate_relative_path "$relative_path"
  target="$PRODUCT_DIR/$relative_path"
  [[ ! -e "$target" ]] || fail "the target already exists: product/$relative_path"

  git_product fetch --prune origin
  if git_product show-ref --verify --quiet "refs/heads/$branch"; then
    git_product worktree add "$target" "$branch"
  elif git_product show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git_product worktree add --track -b "$branch" "$target" "origin/$branch"
  else
    git_product rev-parse --verify --quiet "$start_point^{commit}" >/dev/null ||
      fail "starting reference '$start_point' was not found."
    git_product worktree add -b "$branch" "$target" "$start_point"
  fi

  printf 'Worktree created: product/%s (%s)\n' "$relative_path" "$branch"
}

product_remove() {
  local relative_path="${1:-}"
  [[ -n "$relative_path" ]] || fail "the relative worktree path is required."
  validate_relative_path "$relative_path"
  git_product worktree remove "$PRODUCT_DIR/$relative_path"
}

doctor() {
  local run_knowledge="${1:-0}"
  local failed=0
  require_git
  printf 'OK  git: %s\n' "$(git --version)"
  [[ -f "$ROOT_DIR/AGENTS.md" ]] && printf 'OK  orchestrator: AGENTS.md\n' || {
    printf 'FAIL orchestrator is missing\n' >&2
    failed=1
  }
  [[ -f "$ROOT_DIR/PROJECT.md" ]] && printf 'OK  project definition: PROJECT.md\n' || {
    printf 'FAIL project definition is missing\n' >&2
    failed=1
  }
  grep -Eq '^/product/$' "$ROOT_DIR/.gitignore" && printf 'OK  product/ is ignored\n' || {
    printf 'FAIL product/ is not ignored\n' >&2
    failed=1
  }
  if [[ -d "$BARE_DIR" || -e "$PRODUCT_DIR/.git" ]]; then
    require_product_repository
    git_product fsck --no-progress >/dev/null
    printf 'OK  product repository: product/.bare\n'
  else
    printf 'INFO code repository is not initialized\n'
  fi
  if [[ "$run_knowledge" -eq 1 ]]; then
    command -v python3 >/dev/null 2>&1 || fail "python3 is required for 'doctor --knowledge'."
    python3 "$ROOT_DIR/bin/habenae_knowledge.py" --root "$ROOT_DIR" || failed=1
  fi
  return "$failed"
}

main() {
  require_git
  case "${1:-}" in
    doctor)
      shift
      local run_knowledge=0
      if [[ "${1:-}" == "--knowledge" ]]; then
        run_knowledge=1
        shift
      fi
      [[ $# -eq 0 ]] || fail "doctor accepts only an optional --knowledge flag."
      doctor "$run_knowledge"
      ;;
    product)
      shift
      case "${1:-}" in
        init)
          shift
          product_init "$@"
          ;;
        add)
          shift
          require_product_repository
          product_add "$@"
          ;;
        list)
          shift
          [[ $# -eq 0 ]] || fail "product list does not accept arguments."
          require_product_repository
          git_product worktree list
          ;;
        remove)
          shift
          require_product_repository
          product_remove "$@"
          ;;
        prune)
          shift
          [[ $# -eq 0 ]] || fail "product prune does not accept arguments."
          require_product_repository
          git_product worktree prune --verbose
          ;;
        *) usage; exit 2 ;;
      esac
      ;;
    -h|--help|help) usage ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
